    <!-- Presets -->
    <string name="preset_auto_label">Auto — cascade</string>
    <string name="preset_auto_desc">Strong disorder + split cascade. Main universal option.</string>
    <string name="preset_split_label">SNI split</string>
    <string name="preset_split_desc">Multi-point split without FAKE. Usually lighter on battery and latency.</string>
    <string name="preset_tlsrec_label">TLS-record + FAKE</string>
    <string name="preset_tlsrec_desc">Split + TLS-record + low TTL. Fallback for strict DPI.</string>
    <string name="preset_split_minimal_label">Minimal split</string>
    <string name="preset_split_minimal_desc">Single cut at SNI — minimal load and a quick test.</string>
    <string name="preset_tlsrec_minimal_label">Minimal TLS-record</string>
    <string name="preset_tlsrec_minimal_desc">Only TLS-record re-fragmentation at SNI.</string>
    <string name="preset_disorder_minimal_label">Minimal disorder</string>
    <string name="preset_disorder_minimal_desc">Reverse segment order at SNI without cascade.</string>
    <string name="preset_split_triple_label">Split: 3 points</string>
    <string name="preset_split_triple_desc">Short split cascade for networks where long chains break the connection.</string>
    <string name="preset_disorder_split_label">Disorder + split</string>
    <string name="preset_disorder_split_desc">Simple combo of two basic methods.</string>
    <string name="preset_split_tlsrec_label">Split + TLS-record</string>
    <string name="preset_split_tlsrec_desc">Two ways to hide the ClientHello boundary without a FAKE packet.</string>
    <string name="preset_mixed_short_label">Short mix</string>
    <string name="preset_mixed_short_desc">Disorder and split at several early positions.</string>
    <string name="preset_mixed_step_label">Cascade with step</string>
    <string name="preset_mixed_step_desc">Sparse cascade for DPI that reassembles the first segments.</string>
    <string name="preset_tlsrec_double_label">Double TLS-record</string>
    <string name="preset_tlsrec_double_desc">TLS-record and split at different positions.</string>
    <string name="preset_auto_oob_label">OOB + auto</string>
    <string name="preset_auto_oob_desc">Out-of-band segment with automatic fallback sections.</string>
    <string name="preset_disorder_oob_label">Disorder + OOB</string>
    <string name="preset_disorder_oob_desc">Reverse order and OOB for networks with strong TCP analysis.</string>
    <string name="preset_fake_ttl6_label">FAKE TTL 6 + split</string>
    <string name="preset_fake_ttl6_desc">Low TTL on FAKE packet and split of the real ClientHello.</string>
    <string name="preset_fake_ttl8_label">FAKE TTL 8 + TLS-record</string>
    <string name="preset_fake_ttl8_desc">More aggressive FAKE with TLS-record.</string>
    <string name="preset_long_cascade_label">Long cascade</string>
    <string name="preset_long_cascade_desc">Many disorder + split points for strict DPI profiles.</string>
    <string name="preset_oob_disorder_label">Disoob + OOB</string>
    <string name="preset_oob_disorder_desc">Experimental combo of reverse OOB and plain OOB.</string>
    <string name="preset_fake_random_tls_label">FAKE with random TLS</string>
    <string name="preset_fake_random_tls_desc">Changes fake ClientHello parameters; sometimes helps against signatures.</string>
    <string name="preset_fake_original_tls_label">FAKE with original TLS</string>
    <string name="preset_fake_original_tls_desc">Keeps original fake ClientHello parameters.</string>
    <string name="preset_fake_google_sni_label">FAKE: Google SNI</string>
    <string name="preset_fake_google_sni_desc">SNI swap only in the decoy packet. Test on your network.</string>
    <string name="preset_fake_microsoft_sni_label">FAKE: Microsoft SNI</string>
    <string name="preset_fake_microsoft_sni_desc">Alternative SNI swap in the decoy packet.</string>
